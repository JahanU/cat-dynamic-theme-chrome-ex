{
  "manifest_version": 3,
  "name": "Tabby Tab – Cat wallpaper",
  "version": "2.0",
  "description": "Tabby Tab – Cat wallpaper",
  "icons": {
    "16": "cat.png",
    "48": "cat.png",
    "128": "cat.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
