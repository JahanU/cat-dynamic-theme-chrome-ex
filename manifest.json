{
  "manifest_version": 3,
  "name": "Cat gifs Wallpaper",
  "version": "2.0",
  "description": "Cat gifs Wallpaper",
  "icons": {
    "16": "cat.png",
    "48": "cat.png",
    "128": "cat.png"
