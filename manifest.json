{
  "manifest_version": 3,
  "name": "Tabby Tab – Cat Wallpaper",
  "version": "2.2",
  "description": "Tabby Tab – Cat Wallpaper",
  "icons": {
    "16": "cat.png",
    "48": "cat.png",
    "128": "cat.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/", "https://www.google.com/?*", "https://www.google.com/webhp*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://search.brave.com/", "https://search.brave.com/?*"],
      "css": ["style.css", "brave.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
